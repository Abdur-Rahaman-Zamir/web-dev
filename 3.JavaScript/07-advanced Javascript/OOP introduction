class student{ 
    constructor(name,age,){  //this is constructor method
this.studentname=name;
this.studentage=age;
    console.log("constructor function");
    }
    hello(){      //this is prototype method
        console.log(`Hello ${this.studentname} your age is ${this.studentage}`);
    }       

    static info(){   //this is static method
        console.log("This is student class");
    }
}
let student1=new student("Zamir",27);
let student2=new student("Abdullah",26);
student1.hello();  
student2.hello();
student.info();  //static method call